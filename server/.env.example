MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
HOST_NAME=127.0.0.1
PORT=3000

# TLS: auto-enabled when server/certs/dev-*.pem exist (run npm run certs:generate)
USE_TLS=true
TLS_KEY_PATH=./certs/dev-key.pem
TLS_CERT_PATH=./certs/dev-cert.pem
COOKIE_SECURE=true

# Comma-separated frontend origins (must match Vite dev URL scheme)
FRONTEND_ORIGIN=https://127.0.0.1:5173,https://localhost:5173

# Optional: redirect plain HTTP to HTTPS (port 3001 -> 3000)
HTTP_REDIRECT_PORT=3001
HTTP_REDIRECT=true

# INPUT VALIDATION REQUIREMENTS:
# - Email: valid email format, max 254 characters
# - Password: min 8 chars, max 128 chars, requires:
#   * At least 1 uppercase letter (A-Z)
#   * At least 1 lowercase letter (a-z)
#   * At least 1 number (0-9)
#   * At least 1 special character (!@#$%^&*()_+−=[]{};':"\\|,.<>/?)
